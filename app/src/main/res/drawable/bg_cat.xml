<?xml version="1.0" encoding="utf-8"?>
<!-- Categoría: enfocada = azul fuerte; la elegida (activated) = azul suave; las demás = tarjeta oscura. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/accent" /><corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" /></shape>
    </item>
    <item android:state_activated="true">
        <shape><solid android:color="#FF1D4ED8" /><corners android:radius="12dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#FF16233F" /><corners android:radius="12dp" /></shape>
    </item>
</selector>
