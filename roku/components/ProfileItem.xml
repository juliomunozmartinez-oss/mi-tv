<?xml version="1.0" encoding="utf-8"?>
<!-- Un perfil en «¿Quién está viendo?» -->
<component name="ProfileItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="focusPercent" type="float" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="ProfileItem.brs" />
    <children>
        <Poster id="avatar" width="200" height="200" translation="[10,0]" />
        <Label id="name" width="220" translation="[0,214]" horizAlign="center" color="0x94A3B8FF" />
        <Label id="badge" width="220" translation="[0,252]" horizAlign="center" color="0x60A5FAFF" />
    </children>
</component>
