<?xml version="1.0" encoding="utf-8"?>
<!-- Una tarjeta del carrusel: póster (o logo del canal), barra de avance y estrella de Mi lista. -->
<component name="PosterItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="onSize" />
        <field id="height" type="float" onChange="onSize" />
        <field id="focusPercent" type="float" />
    </interface>
    <script type="text/brightscript" uri="PosterItem.brs" />
    <script type="text/brightscript" uri="Utils.brs" />
    <children>
        <Rectangle id="bg" color="0x1E2A42FF" />
        <Label id="fallback" horizAlign="center" vertAlign="center" wrap="true" color="0xFFFFFFFF" />
        <Poster id="poster" loadDisplayMode="scaleToZoom" />
        <Rectangle id="progressBg" color="0xFFFFFF55" visible="false" />
        <Rectangle id="progress" color="0x3B82F6FF" visible="false" />
        <Label id="star" text="★" color="0xFACC15FF" visible="false" />
    </children>
</component>
