<?xml version="1.0" encoding="utf-8"?>
<!-- Hace una consulta al servidor en segundo plano y regresa el resultado en «response». -->
<component name="ApiTask" extends="Task">
    <interface>
        <field id="request" type="assocarray" />
        <field id="response" type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="ApiTask.brs" />
    <script type="text/brightscript" uri="Utils.brs" />
</component>
